---
import { buttonVariants } from '@workspace/ui/components/button'
import { ArrowUpRight, KeyRound } from 'lucide-react'

import AlpacaLogo from '@/components/alpaca/alpaca-logo.astro'
import Logo from '@/components/logo.astro'
import SectionIntro from '@/components/section-intro.astro'
import { externalLinks } from '@/lib/links'

/** What it takes to go from nothing to trading in Treid, in order. */
const steps = [
  {
    note: 'A paper account is free and trades with play money.',
    title: 'Open an Alpaca account',
  },
  {
    note: 'Make a key set in the Alpaca dashboard, for paper, live or both.',
    title: 'Create your API keys',
  },
  {
    note: 'Paste them into a connection. They are encrypted as you save them.',
    title: 'Add them to Treid',
  },
]
---

<!--
  The one requirement: Treid trades through the visitor's own Alpaca account.
  The two logos joined by a key, then the three steps to get connected.
-->
<section aria-labelledby="alpaca-title" class="scroll-mt-24 py-24 md:py-40" id="alpaca">
  <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:gap-16">
    <div class="flex flex-col items-start gap-8">
      <SectionIntro id="alpaca-title" muted=" You'll need an account there." title="Treid runs on Alpaca.">
        Alpaca is your broker. It holds your money and fills your orders. Treid is the desk you trade
        from, so you need an Alpaca account to use it. A paper account works.
      </SectionIntro>
      <a class={buttonVariants({ size: 'xl', variant: 'outline' })} href={externalLinks.alpacaSignUp}>
        Open an Alpaca account
        <ArrowUpRight aria-hidden="true" data-icon="inline-end" />
      </a>
    </div>

    <figure aria-labelledby="alpaca-steps-title" class="flex flex-col rounded-[2rem] ring-1 ring-border">
      <div class="flex items-center gap-3 px-6 pt-8 pb-7 sm:gap-4 sm:px-8">
        <Logo class="shrink-0" />
        <span aria-hidden="true" class="relative flex flex-1 items-center justify-center">
          <span class="absolute inset-x-0 top-1/2 border-t border-dashed"></span>
          <span class="relative flex size-9 items-center justify-center rounded-full bg-muted ring-4 ring-background">
            <KeyRound className="size-4" />
          </span>
        </span>
        <AlpacaLogo class="shrink-0" />
      </div>
      <figcaption class="sr-only" id="alpaca-steps-title">How Treid connects to your Alpaca account</figcaption>
      <ol class="flex flex-col divide-y border-t px-6 sm:px-8">
        {
          steps.map((step, index) => (
            <li class="flex gap-4 py-5">
              <span class="font-mono text-muted-foreground leading-7 tabular-nums">{index + 1}</span>
              <span class="flex flex-col gap-1">
                <span class="font-bold text-lg">{step.title}</span>
                <span class="text-muted-foreground">{step.note}</span>
              </span>
            </li>
          ))
        }
      </ol>
    </figure>
  </div>
</section>
