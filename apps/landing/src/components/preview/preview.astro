---
import { buttonVariants } from '@workspace/ui/components/button'
import { cn } from '@workspace/ui/lib/utils'
import {
  ArrowRight,
  ArrowUpRight,
  CircleUser,
  House,
  Search,
  Wallet,
} from 'lucide-react'

import OrderRow from '@/components/preview/order-row.astro'
import PositionRow from '@/components/preview/position-row.astro'
import SectionIntro from '@/components/section-intro.astro'
import Sparkline from '@/components/sparkline.astro'
import { balance, balanceSeries, orders, positions } from '@/lib/market'
import {
  buildSparkline,
  formatCurrency,
  formatSignedPercent,
} from '@/lib/utils'

const chartHeight = 240
const chartEnd = buildSparkline({
  height: chartHeight,
  values: balanceSeries,
  width: 1000,
}).end
const [whole, cents] = formatCurrency({ value: balance.value })
  .replace('$', '')
  .split('.')
const periods = ['1D', '1W', '1M', '3M', '1Y', 'All']
const navIcons = [House, Wallet, CircleUser]
const stats = [
  {
    label: 'Buying power',
    value: formatCurrency({ value: balance.buyingPower }),
  },
  { label: 'Cash', value: formatCurrency({ value: balance.cash }) },
  { label: 'Positions', value: String(positions.length + 4) },
]
---

<!-- A faithful, static mock of the portfolio home inside a window frame. -->
<section aria-labelledby="preview-title" class="scroll-mt-24 py-24 md:py-40" id="preview">
  <div class="mx-auto flex max-w-6xl flex-col gap-12 px-4 sm:px-6 md:gap-16">
    <SectionIntro id="preview-title" muted=" All on one calm screen." title="Your balance, positions and orders.">
      The balance is the biggest thing on the page and updates in place. Everything else stays out of
      its way.
    </SectionIntro>

    <figure
      aria-label="Preview of the Treid portfolio home"
      class="relative max-h-[60rem] overflow-hidden rounded-[2rem] bg-background mask-b-from-85% ring-1 ring-border md:max-h-none"
      inert
      role="img"
    >
      <div class="flex items-center justify-between gap-3 p-4 sm:px-6 md:pl-24">
        <div
          class="elevation-well flex h-9 w-full max-w-64 items-center gap-2 rounded-lg bg-muted/50 px-3 text-muted-foreground"
        >
          <Search aria-hidden="true" className="size-4" />
          <span class="truncate">Search assets</span>
        </div>
        <div class="flex shrink-0 items-center gap-2">
          <span class={buttonVariants({ size: 'lg' })}>Buy / Sell</span>
          <span
            class="flex size-9 items-center justify-center rounded-full bg-muted font-medium text-muted-foreground text-sm"
          >
            AR
          </span>
        </div>
      </div>

      <ul class="surface-floating absolute top-1/4 left-4 hidden flex-col gap-2 rounded-full p-2 md:flex">
        {
          navIcons.map((Icon, index) => (
            <li
              class={cn(
                'flex size-11 items-center justify-center rounded-full text-muted-foreground',
                index === 0 && 'bg-foreground text-background'
              )}
            >
              <Icon aria-hidden="true" className="size-5" />
            </li>
          ))
        }
      </ul>

      <div class="flex flex-col gap-2 px-4 pt-6 sm:px-6 md:pl-24">
        <span class="text-muted-foreground">Balance</span>
        <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 tabular-nums">
          <span class="font-bold text-6xl tracking-tighter md:text-8xl">
            <span class="font-medium text-3xl text-muted-foreground md:text-5xl">$</span>{whole}<span
              class="text-muted-foreground">.{cents}</span
            >
          </span>
          <span class="inline-flex items-center gap-1 font-medium text-2xl text-market-up tracking-tight md:text-4xl">
            <ArrowUpRight aria-hidden="true" className="size-6 md:size-8" />
            {formatSignedPercent({ value: balance.change })}
          </span>
        </div>
      </div>

      <div class="relative mt-4 h-56 [mask-image:linear-gradient(to_right,transparent,black_8%)] md:h-72">
        <div class="absolute inset-0 pr-[8%]">
          <Sparkline
            class="size-full"
            height={chartHeight}
            id="preview-balance"
            tone="market-up"
            values={balanceSeries}
            width={1000}
          />
        </div>
        <span
          class="absolute -translate-x-1/2 -translate-y-1/2"
          style={`left: 92%; top: ${(chartEnd.y / chartHeight) * 100}%`}
        >
          <span class="absolute inset-0 animate-ping rounded-full bg-market-up/40 motion-reduce:hidden"></span>
          <span class="relative block size-3 rounded-full bg-market-up ring-2 ring-background"></span>
        </span>
      </div>

      <div class="flex flex-col gap-10 px-4 pb-16 sm:px-6 md:pl-24">
        <div class="flex gap-1 overflow-x-auto scrollbar-none">
          {
            periods.map((period) => (
              <span
                aria-pressed={period === '1Y'}
                class={buttonVariants({ variant: period === '1Y' ? 'secondary' : 'ghost' })}
              >
                {period}
              </span>
            ))
          }
        </div>

        <dl class="grid divide-y border-y sm:grid-cols-3 sm:divide-x sm:divide-y-0">
          {
            stats.map((stat) => (
              <div class="flex flex-col gap-1 py-4 sm:px-6 sm:first:pl-0">
                <dt class="text-muted-foreground">{stat.label}</dt>
                <dd class="font-bold text-3xl tracking-tight tabular-nums">{stat.value}</dd>
              </div>
            ))
          }
        </dl>

        <div class="grid gap-10 lg:grid-cols-2 lg:gap-x-16">
          <div class="flex flex-col gap-4">
            <div class="flex items-center justify-between gap-3">
              <span class="font-bold text-2xl tracking-tight">Top positions</span>
              <span class="inline-flex items-center gap-1.5 font-medium text-muted-foreground">
                View all <ArrowRight aria-hidden="true" className="size-4" />
              </span>
            </div>
            <ul>{positions.map((position) => <PositionRow position={position} />)}</ul>
          </div>
          <div class="flex flex-col gap-4">
            <div class="flex items-center justify-between gap-3">
              <span class="font-bold text-2xl tracking-tight">Recent orders</span>
              <span class="inline-flex items-center gap-1.5 font-medium text-muted-foreground">
                View all <ArrowRight aria-hidden="true" className="size-4" />
              </span>
            </div>
            <ul>{orders.map((order) => <OrderRow order={order} />)}</ul>
          </div>
        </div>
      </div>
    </figure>
  </div>
</section>
