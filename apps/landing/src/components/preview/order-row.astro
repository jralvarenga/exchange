---
import { cn } from '@workspace/ui/lib/utils'

import AssetLogo from '@/components/asset-logo.astro'
import type { Order } from '@/lib/market'
import { formatCurrency } from '@/lib/utils'

interface Props {
  order: Order
}

const { order } = Astro.props
const isOpen = order.status === 'open'
---

<!-- The app's order row: logo, symbol and order detail, size and status pill. -->
<li class="grid grid-cols-[auto_1fr_auto] items-center gap-x-4 py-3">
  <AssetLogo size="row" symbol={order.symbol} />
  <div class="flex min-w-0 flex-col gap-0.5">
    <span class="truncate font-bold text-lg">{order.symbol}</span>
    <span class="truncate text-muted-foreground">{order.detail}</span>
  </div>
  <div class="flex flex-col items-end gap-1 tabular-nums">
    <span class="font-bold text-lg">{formatCurrency({ value: order.amount })}</span>
    <span
      class={cn(
        'inline-flex shrink-0 items-center gap-1.5 whitespace-nowrap rounded-full px-2.5 py-0.5 font-medium',
        isOpen ? 'bg-warning/10 text-warning' : 'bg-market-up/10 text-market-up'
      )}
    >
      <span
        class={cn('size-1.5 rounded-full bg-current', isOpen && 'animate-pulse motion-reduce:animate-none')}
      ></span>
      {isOpen ? 'Open' : 'Filled'}
    </span>
  </div>
</li>
