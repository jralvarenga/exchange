# Local Postgres and Mailpit. Production uses Neon and Resend.
# Generate BETTER_AUTH_SECRET and CREDENTIALS_ENCRYPTION_KEYS with `bun run auth:secrets`.

DATABASE_URL=postgresql://exchange:exchange@127.0.0.1:5432/exchange
BETTER_AUTH_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BETTER_AUTH_URL=http://127.0.0.1:3000
GOOGLE_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY=
EMAIL_FROM=Exchange <exchange@example.com>
CREDENTIALS_ENCRYPTION_KEYS=k1:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional extra HTTPS origins, comma-separated.
# BETTER_AUTH_TRUSTED_ORIGINS=

ALPACA_CRYPTO_LOCATION=us
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
