---
import { cn } from '@workspace/ui/lib/utils'
import { ArrowDownRight, ArrowUpRight } from 'lucide-react'

import AssetLogo from '@/components/asset-logo.astro'
import type { Position } from '@/lib/market'
import { formatCurrency, formatSignedPercent } from '@/lib/utils'

interface Props {
  position: Position
}

const { position } = Astro.props
const ReturnIcon = position.return < 0 ? ArrowDownRight : ArrowUpRight
const allocation = Math.round(position.allocation * 100)
---

<!-- The app's position row: logo, symbol and size, value and return, allocation bar. -->
<li class="grid grid-cols-[auto_1fr_auto] items-center gap-x-4 gap-y-3 py-3">
  <AssetLogo size="row" symbol={position.symbol} />
  <div class="flex min-w-0 flex-col gap-0.5">
    <span class="truncate font-bold text-lg">{position.symbol}</span>
    <span class="truncate text-muted-foreground tabular-nums">
      {position.quantity} × {formatCurrency({ value: position.price })}
    </span>
  </div>
  <div class="flex flex-col items-end gap-0.5 tabular-nums">
    <span class="font-bold text-lg">
      {formatCurrency({ value: position.quantity * position.price })}
    </span>
    <span
      class={cn(
        'inline-flex items-center gap-0.5 font-medium',
        position.return < 0 ? 'text-market-down' : 'text-market-up'
      )}
    >
      <ReturnIcon aria-hidden="true" className="size-4" />
      {formatSignedPercent({ value: position.return })}
    </span>
  </div>
  <div class="col-span-3 flex items-center gap-3 sm:col-span-2 sm:col-start-2">
    <span class="h-1 flex-1 overflow-hidden rounded-full bg-muted">
      <span class="block h-full rounded-full bg-foreground/70" style={`width: ${allocation}%`}></span>
    </span>
    <span class="w-14 text-right text-muted-foreground tabular-nums">{allocation}%</span>
  </div>
</li>
