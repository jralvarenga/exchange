---
import Analytics from '@vercel/analytics/astro'

import { Font } from 'astro:assets'

import '@/styles/globals.css'

interface Props {
  description?: string
  title?: string
}

const {
  description = 'A quiet trading desk for your Alpaca account. Paper or live, on your own or with a team.',
  title = 'Treid · Trade on Alpaca without the noise',
} = Astro.props
---

<!doctype html>
<html lang="en" class="scroll-pt-24 overflow-x-clip font-sans antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />
    <title>{title}</title>
    <!-- Cookieless page-view counts. Only reports when deployed on Vercel. -->
    <Analytics />
    <!--
      Follows the system theme before paint. The app's saved theme lives in its
      own origin's storage, so the landing page has no stored choice to read.
    -->
    <script is:inline>
      ;(() => {
        const query = window.matchMedia('(prefers-color-scheme: dark)')

        function applyTheme() {
          const dark = query.matches
          document.documentElement.classList.toggle('dark', dark)
          document.documentElement.style.colorScheme = dark ? 'dark' : 'light'
        }

        applyTheme()
        query.addEventListener('change', applyTheme)
      })()
    </script>
  </head>
  <body class="overflow-x-clip">
    <slot />
  </body>
</html>
